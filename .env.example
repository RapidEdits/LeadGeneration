# ============================================================================
# Lead Generator — environment configuration (Phase 1)
# Copy to `.env` and fill values. NEVER commit the real .env.
# ============================================================================

# ---- Core / app ----
ENVIRONMENT=development                 # development | staging | production
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins (frontend URLs)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
# Fernet key for encrypting connected-account credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-real-fernet-key
ACCESS_TOKEN_EXPIRE_MINUTES=43200       # 30 days
JWT_ALGORITHM=HS256

# ---- Database (PostgreSQL) ----
POSTGRES_USER=leadgen
POSTGRES_PASSWORD=leadgen_dev_password
POSTGRES_DB=leadgen
POSTGRES_HOST=postgres                   # 'postgres' inside docker; 'localhost' if running backend on host
POSTGRES_PORT=5432
# Full URL is derived from the pieces above by the backend config, but can be overridden:
# DATABASE_URL=postgresql+psycopg://leadgen:leadgen_dev_password@postgres:5432/leadgen

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- AI ----
# All AI calls funnel through the swappable AIService. AI_PROVIDER=auto uses DeepSeek
# when NVIDIA_API_KEY is set, otherwise Gemma when GEMINI_API_KEY is set, otherwise a
# null service that returns "unknown" instead of fabricating. Force with "deepseek" /
# "gemma" / "null".
AI_PROVIDER=auto

# DeepSeek (recommended) via an OpenAI-compatible endpoint — default is NVIDIA's
# inference API. Get a free key at https://build.nvidia.com (Account -> API Keys).
# Used for every AI task: lead qualification, email / LinkedIn / follow-up generation,
# reply classification, NL search, campaign & analytics insights, Copilot.
NVIDIA_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
DEEPSEEK_MODEL=deepseek-ai/deepseek-v4-pro-0813

# Gemma via Google Generative Language API (legacy / fallback). List models your key
# can access: GET /v1beta/models?key=...
GEMINI_API_KEY=
AI_MODEL=gemma-4-31b-it

# ---- Email (Phase 3: live send, tracking, replies, bounces) ----
# Public origin where lead mail clients & OAuth providers reach tracking/callback endpoints.
# In dev this is the backend; in prod a public HTTPS URL (e.g. https://api.yourapp.com).
PUBLIC_BASE_URL=http://localhost:8000
# Frontend origin OAuth flows redirect back to.
APP_BASE_URL=http://localhost:3000
EMAIL_TRACKING_ENABLED=true
INBOUND_POLL_ENABLED=true
DEFAULT_FROM_NAME=Lead Generator
# Cross-campaign frequency cap (hours): a lead won't be contacted on the same channel
# more than once within this window by DIFFERENT campaigns. Set 0 to disable (dev/testing).
FREQUENCY_CAP_HOURS=24

# Google OAuth (Gmail / Workspace send + read). Create an OAuth client (Web application) at
# console.cloud.google.com, enable the Gmail API, and add this authorized redirect URI:
#   ${PUBLIC_BASE_URL}/api/v1/accounts/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft OAuth (Microsoft 365 / Outlook via Graph). Register an app at
# entra.microsoft.com, add Mail.Send + Mail.Read + offline_access, and this redirect URI:
#   ${PUBLIC_BASE_URL}/api/v1/accounts/oauth/microsoft/callback
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common            # or a specific tenant id

# SMTP/IMAP fallback defaults (per-account creds are stored encrypted in connected_accounts).
# For local dev the Mailpit container provides SMTP:1025 (no auth) and a UI at :8025.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- WhatsApp (OpenWA microservice — Phase 6) ----
# OpenWA is UNOFFICIAL WhatsApp Web automation. ToS/ban risk on the connected number (accepted).
WHATSAPP_SERVICE_URL=http://whatsapp-service:3100
WHATSAPP_SERVICE_TOKEN=change-me-internal-shared-secret

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
